-- 2. CREATING THE GREEN DRAWING CIRCLE
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = AimbotConfig.CircleColor
FOVCircle.Thickness = 2
FOVCircle.Radius = AimbotConfig.CircleRadius
FOVCircle.Filled = false
FOVCircle.Visible = true

local function updateCircle()
    local screenSize = Camera.ViewportSize
    FOVCircle.Position = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
end

-- 3. CORE FUNCTIONS & METATABLE HOOK
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = AimbotConfig.MaxDistance
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild(AimbotConfig.TargetPart) then
        return nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(AimbotConfig.TargetPart) then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local distance = (LocalPlayer.Character[AimbotConfig.TargetPart].Position - player.Character[AimbotConfig.TargetPart].Position).Magnitude
                if distance < shortestDistance then
                    closestPlayer = player
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

-- Hooking Logic
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if AimbotConfig.Enabled and (method == "FireServer" or method == "InvokeServer") then
        if tostring(self) == "Combat" or tostring(self) == "RegisterAttack" or tostring(self) == "MainRemote" then
            local target = getClosestPlayer()
            if target and target.Character and target.Character:FindFirstChild(AimbotConfig.TargetPart) then
                args[1] = target.Character[AimbotConfig.TargetPart].Position
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

game:GetService("RunService").RenderStepped:Connect(function()
    updateCircle()
end)

print("[AIMBOT] Fully Loaded with Screen UI and Visual Circles!")
